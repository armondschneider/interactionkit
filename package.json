{
  "name": "interactionkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lib": "rollup -c rollup.config.mjs",
    "build:lib:watch": "rollup -c rollup.config.mjs --watch",
    "check:lib": "npm run prepublishOnly && node scripts/check-package.mjs",
    "prepublishOnly": "npm run build:lib && cp lib-package.json dist/package.json && cp README.md LICENSE dist/",
    "pack:lib": "npm run check:lib && npm pack ./dist --dry-run",
    "publish:lib": "npm test && npm run check:lib && npm publish ./dist"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.554.0",
    "next": "15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "postcss-modules": "^9.0.1",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
