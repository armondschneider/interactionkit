{
  "name": "intkit",
  "version": "0.0.0",
  "description": "React interaction components for web apps that feel native and fluid",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": ["index.js", "index.cjs", "index.d.ts", "index.js.map", "index.cjs.map", "styles.css"],
  "sideEffects": ["./styles.css"],
  "keywords": ["react", "components", "animation", "ios", "ui", "framer-motion"],
  "author": "Armond Schneider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/armondschneider/interactionkit/issues"
  },
  "homepage": "https://github.com/armondschneider/interactionkit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armondschneider/interactionkit.git"
  },
  "dependencies": {
    "lucide-react": "^0.554.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "framer-motion": "^12.0.0"
  }
}
